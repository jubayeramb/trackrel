{
  "name": "@trackrel/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./validation": {
      "types": "./src/validation.ts",
      "default": "./dist/validation.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@trackrel/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "dependencies": {
    "better-auth": "^1.4.19",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  }
}
